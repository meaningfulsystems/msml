        "style": { "line_color": "#207567", "line_width": 1.5, "line_style": "solid", "source_arrowhead": "none", "target_arrowhead": "open", "label_offset": { "x": -60, "y": -10 } }
      },
      {
        "type": "association",
        "id": "rel-hos-future",
        "name": "protects long-term interests",
        "source": "hos",
        "target": "future-generations",
        "waypoints": [{ "x": 670, "y": 270 }, { "x": 760, "y": 125 }],
        "style": { "line_color": "#2E7D32", "line_width": 1.5, "line_style": "solid", "source_arrowhead": "none", "target_arrowhead": "open", "label_offset": { "x": -20, "y": 15 } }
      },
      {
        "type": "association",
        "id": "rel-hos-tech",
        "name": "evaluates pathways and tradeoffs",
        "source": "hos",
        "target": "technology-resources",
        "waypoints": [{ "x": 670, "y": 350 }, { "x": 730, "y": 475 }],
        "style": { "line_color": "#B5522C", "line_width": 1.5, "line_style": "solid", "source_arrowhead": "none", "target_arrowhead": "open", "label_offset": { "x": -30, "y": -10 } }
      },
      {
        "type": "association",
        "id": "rel-hos-decision",
        "name": "supports judgment, not control",
        "source": "hos",
        "target": "decision-makers",
        "waypoints": [{ "x": 520, "y": 235 }, { "x": 520, "y": 150 }],
        "style": { "line_color": "#6D4C9A", "line_width": 1.5, "line_style": "solid", "source_arrowhead": "none", "target_arrowhead": "open", "label_offset": { "x": 10, "y": 0 } }
