      },
      {
        "id": "HOS.Port.HosValuesInput",
        "type": "port",
        "name": "valuesIn",
        "owner_ref": "HOS.HumanityOptimizationSystem"
      },
      {
        "id": "HOS.Port.HosWorldSignalsInput",
        "type": "port",
        "name": "worldSignals",
        "owner_ref": "HOS.HumanityOptimizationSystem"
      },
      {
        "id": "HOS.Port.HumanityValuesOutput",
        "type": "port",
