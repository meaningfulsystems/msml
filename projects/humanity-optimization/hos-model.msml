            },
            {
              "name": "evaluateInterventions",
              "parameters": [],
              "return_type": "OptionPortfolio"
            },
            {
              "name": "briefDecisionMakers",
              "parameters": [],
              "return_type": "DecisionBrief"
            }
          ]
        }
      },
      {
        "id": "HOS.Port.DecisionBriefInput",
        "type": "port",
        "name": "decisionBrief",
