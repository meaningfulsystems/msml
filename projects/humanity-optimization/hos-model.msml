          "properties": [
            {
              "name": "futures",
              "type": "PossibleFuture",
              "multiplicity": "*"
            },
            {
              "name": "uncertainty",
              "type": "ConfidenceRange",
              "multiplicity": "*"
            }
          ],
          "operations": [
            {
              "name": "simulatePathways",
              "parameters": [],
              "return_type": "ScenarioSet"
            }
          ]
        }
      },
      {
        "type": "block",
        "id": "HOS.TechnologyResources",
        "name": "TechnologyResources",
        "stereotype": "block"
      }
    ],
    "relationships": [
      {
        "id": "act-hos-operating-loop.f1",
        "type": "control_flow",
        "source": "HOS.Activity.OperatingLoop.Start",
        "target": "HOS.Activity.ObserveWorld"
      },
      {
        "type": "control_flow",
        "id": "act-hos-operating-loop.f10",
        "source": "HOS.Activity.InformDecisions",
        "target": "HOS.Activity.ObserveWorld",
        "name": "monitor outcomes and update assumptions"
      },
      {
        "type": "control_flow",
        "id": "act-hos-operating-loop.f2",
        "source": "HOS.Activity.ObserveWorld",
        "target": "HOS.Activity.ModelFutures"
      },
      {
        "type": "control_flow",
        "id": "act-hos-operating-loop.f3",
        "source": "HOS.Activity.ModelFutures",
        "target": "HOS.Activity.IdentifyRisks"
      },
      {
        "id": "act-hos-operating-loop.f4",
        "type": "control_flow",
        "source": "HOS.Activity.IdentifyRisks",
        "target": "HOS.Activity.OperatingLoop.Fork.RiskReview"
      },
      {
        "id": "act-hos-operating-loop.f5",
        "type": "control_flow",
        "source": "HOS.Activity.OperatingLoop.Fork.RiskReview",
        "target": "HOS.Activity.EvaluatePortfolios"
      },
      {
        "id": "act-hos-operating-loop.f6",
        "type": "control_flow",
        "source": "HOS.Activity.OperatingLoop.Fork.RiskReview",
        "target": "HOS.Activity.CheckEthics"
      },
      {
        "id": "act-hos-operating-loop.f7",
        "type": "control_flow",
        "source": "HOS.Activity.EvaluatePortfolios",
        "target": "HOS.Activity.OperatingLoop.Join.AfterEthicsAndPortfolio"
      },
      {
        "id": "act-hos-operating-loop.f8",
        "type": "control_flow",
        "source": "HOS.Activity.CheckEthics",
        "target": "HOS.Activity.OperatingLoop.Join.AfterEthicsAndPortfolio"
      },
      {
        "id": "act-hos-operating-loop.f9",
        "type": "control_flow",
        "source": "HOS.Activity.OperatingLoop.Join.AfterEthicsAndPortfolio",
        "target": "HOS.Activity.InformDecisions"
      },
      {
        "type": "composition",
        "id": "bdd-hos-definition.comp-hos-briefing",
        "source": "HOS.HumanityOptimizationSystem",
        "target": "HOS.DecisionBriefingInterface",
        "multiplicity_source": "1",
        "multiplicity_target": "1"
      },
      {
        "type": "composition",
        "id": "bdd-hos-definition.comp-hos-ethics",
        "source": "HOS.HumanityOptimizationSystem",
        "target": "HOS.EthicalConstraintGuard",
        "multiplicity_source": "1",
        "multiplicity_target": "1"
      },
      {
        "type": "composition",
        "id": "bdd-hos-definition.comp-hos-evaluator",
        "source": "HOS.HumanityOptimizationSystem",
        "target": "HOS.InterventionEvaluator",
        "multiplicity_source": "1",
        "multiplicity_target": "1"
      },
      {
        "type": "composition",
        "id": "bdd-hos-definition.comp-hos-evidence",
        "source": "HOS.HumanityOptimizationSystem",
        "target": "HOS.EvidenceRepository",
        "multiplicity_source": "1",
        "multiplicity_target": "1"
      },
      {
        "type": "composition",
        "id": "bdd-hos-definition.comp-hos-scenarios",
        "source": "HOS.HumanityOptimizationSystem",
        "target": "HOS.ScenarioModel",
        "multiplicity_source": "1",
        "multiplicity_target": "1"
      },
      {
        "type": "dependency",
        "id": "bdd-hos-definition.dep-ethics-evaluator",
        "name": "options",
        "source": "HOS.EthicalConstraintGuard",
        "target": "HOS.InterventionEvaluator"
      },
      {
        "type": "dependency",
        "id": "bdd-hos-definition.dep-evaluator-scenario",
        "name": "scenarios",
        "source": "HOS.InterventionEvaluator",
        "target": "HOS.ScenarioModel"
      },
      {
        "type": "dependency",
        "id": "bdd-hos-definition.dep-evidence-scenario",
        "name": "evidence",
        "source": "HOS.ScenarioModel",
        "target": "HOS.EvidenceRepository"
      },
      {
        "id": "ibd-hos-system-context.conn-earth-hos",
        "type": "connector",
        "source": "HOS.Port.EarthSignalsOutput",
        "target": "HOS.Port.HosWorldSignalsInput",
        "name": "conditions and warning signals"
      },
      {
        "id": "ibd-hos-system-context.conn-future-hos",
        "type": "connector",
        "source": "HOS.Port.FutureInterestOutput",
        "target": "HOS.Port.HosFutureInterestInput",
        "name": "future interest model"
      },
      {
        "id": "ibd-hos-system-context.conn-hos-decision",
        "type": "connector",
        "source": "HOS.Port.HosDecisionBriefOutput",
        "target": "HOS.Port.DecisionBriefInput",
        "name": "decision brief"
      },
      {
        "id": "ibd-hos-system-context.conn-humanity-hos",
        "type": "connector",
        "source": "HOS.Port.HumanityValuesOutput",
        "target": "HOS.Port.HosValuesInput",
        "name": "needs, values, lived experience"
      },
      {
        "id": "ibd-hos-system-context.conn-tech-hos",
        "type": "connector",
        "source": "HOS.Port.TechnologyPathwaysInput",
        "target": "HOS.Port.HosPathwayQueryOutput",
        "name": "pathways, resources, constraints"
      },
      {
        "type": "message",
        "id": "sd-hos-decision-support.m1",
        "name": "request support",
        "source_lifeline": "HOS.DecisionMakers",
        "target_lifeline": "HOS.HumanityOptimizationSystem",
        "message_sort": "synch_call"
      },
      {
        "type": "message",
        "id": "sd-hos-decision-support.m2",
        "name": "collect evidence",
        "source_lifeline": "HOS.HumanityOptimizationSystem",
        "target_lifeline": "HOS.EvidenceAndModels",
        "message_sort": "asynch_signal"
      },
      {
        "type": "message",
        "id": "sd-hos-decision-support.m3",
        "name": "risk and tradeon analysis",
        "source_lifeline": "HOS.EvidenceAndModels",
        "target_lifeline": "HOS.HumanityOptimizationSystem",
        "message_sort": "reply"
      },
      {
        "type": "message",
        "id": "sd-hos-decision-support.m4",
        "name": "brief options",
        "source_lifeline": "HOS.HumanityOptimizationSystem",
        "target_lifeline": "HOS.DecisionMakers",
        "message_sort": "reply"
      },
      {
        "type": "message",
        "id": "sd-hos-decision-support.m5",
        "name": "choose and implement",
        "source_lifeline": "HOS.DecisionMakers",
        "target_lifeline": "HOS.GovernanceSystem",
        "message_sort": "asynch_signal"
      },
      {
        "type": "message",
        "id": "sd-hos-decision-support.m6",
        "name": "outcome signals",
        "source_lifeline": "HOS.GovernanceSystem",
        "target_lifeline": "HOS.HumanityOptimizationSystem",
        "message_sort": "asynch_signal"
      }
