{
  "msml_version": "1.0",
  "model": {
    "id": "hos-model",
    "name": "Humanity Optimization System",
    "namespace": "HOS",
    "imports": [],
    "definitions": [
      {
        "type": "action",
        "id": "HOS.Activity.CheckEthics",
        "name": "Check Ethical Constraints"
      },
      {
        "type": "action",
        "id": "HOS.Activity.EvaluatePortfolios",
        "name": "Evaluate Intervention Portfolios"
      },
      {
        "id": "HOS.Activity.OperatingLoop.Fork.RiskReview",
        "type": "fork_node",
        "name": "Fork"
      },
      {
        "type": "action",
        "id": "HOS.Activity.IdentifyRisks",
        "name": "Identify Risks, Opportunities, Tradeons"
      },
      {
        "type": "action",
        "id": "HOS.Activity.InformDecisions",
        "name": "Inform Human Decisions"
      },
      {
        "id": "HOS.Activity.OperatingLoop.Start",
        "type": "initial_node",
        "name": "Start"
      },
      {
        "id": "HOS.Activity.OperatingLoop.Join.AfterEthicsAndPortfolio",
        "type": "join_node",
        "name": "Join"
      },
      {
        "type": "action",
        "id": "HOS.Activity.ModelFutures",
        "name": "Model Possible Futures"
      },
      {
        "type": "action",
        "id": "HOS.Activity.ObserveWorld",
        "name": "Observe Humanity, Earth, Risks"
      },
      {
        "type": "block",
        "id": "HOS.DecisionBriefingInterface",
        "name": "DecisionBriefingInterface",
        "stereotype": "interface block",
        "compartments": {
          "properties": [
            {
              "name": "brief",
              "type": "DecisionBrief",
              "multiplicity": "*"
            },
            {
              "name": "explanation",
              "type": "TraceableRationale",
              "multiplicity": "*"
            }
          ],
          "operations": [
            {
              "name": "publishBriefing",
              "parameters": [],
              "return_type": "void"
            }
          ]
        }
      },
      {
        "type": "block",
        "id": "HOS.DecisionMakers",
        "name": "DecisionMakers",
        "stereotype": "block"
      },
      {
        "type": "block",
        "id": "HOS.EarthBiosphere",
        "name": "EarthBiosphere",
        "stereotype": "block"
      },
      {
        "type": "block",
        "id": "HOS.EthicalConstraintGuard",
        "name": "EthicalConstraintGuard",
        "stereotype": "block",
        "compartments": {
          "properties": [
            {
              "name": "constraints",
              "type": "AgencyTransparencyJusticeRule",
              "multiplicity": "*"
            },
            {
              "name": "protectedInterests",
              "type": "StakeholderInterest",
              "multiplicity": "*"
            }
          ],
          "operations": [
            {
              "name": "screenOptions",
              "parameters": [],
              "return_type": "EthicsAssessment"
            }
          ]
        }
      },
      {
        "type": "block",
        "id": "HOS.EvidenceAndModels",
        "name": "Evidence and Models",
        "stereotype": "block"
      },
      {
        "type": "block",
        "id": "HOS.EvidenceRepository",
        "name": "EvidenceRepository",
        "stereotype": "block",
        "compartments": {
          "properties": [
            {
              "name": "observations",
              "type": "WorldSignal",
              "multiplicity": "*"
            },
            {
              "name": "assumptions",
              "type": "Assumption",
              "multiplicity": "*"
            }
          ],
          "operations": [
            {
              "name": "ingestSignals",
              "parameters": [],
              "return_type": "void"
            },
            {
              "name": "publishEvidence",
              "parameters": [],
              "return_type": "EvidenceSet"
            }
          ]
        }
      },
      {
        "type": "block",
        "id": "HOS.FutureGenerations",
        "name": "FutureGenerations",
        "stereotype": "block"
      },
      {
        "type": "block",
        "id": "HOS.GovernanceSystem",
        "name": "Governance System",
        "stereotype": "block"
      },
      {
        "type": "block",
        "id": "HOS.Humanity",
        "name": "Humanity",
        "stereotype": "block"
      },
      {
        "type": "block",
        "id": "HOS.HumanityOptimizationSystem",
        "name": "HumanityOptimizationSystem",
        "stereotype": "block",
        "compartments": {
          "properties": [
            {
              "name": "mission",
              "type": "CivilizationDecisionSupport",
              "multiplicity": "1"
            },
            {
              "name": "agencyConstraint",
              "type": "HumanAgencyPreservation",
              "multiplicity": "1"
            },
            {
              "name": "objectiveSet",
              "type": "PluralHumanAndEcologicalGoals",
              "multiplicity": "*"
            }
          ],
          "operations": [
            {
              "name": "observeWorld",
              "parameters": [],
              "return_type": "EvidenceSet"
            },
            {
              "name": "modelFutures",
              "parameters": [],
