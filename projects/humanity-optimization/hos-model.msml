        "type": "block",
        "id": "HOS.InterventionEvaluator",
        "name": "InterventionEvaluator",
        "stereotype": "block",
        "compartments": {
          "properties": [
            {
              "name": "portfolios",
              "type": "InterventionPortfolio",
              "multiplicity": "*"
            },
            {
              "name": "tradeons",
              "type": "MultiObjectiveGain",
              "multiplicity": "*"
            }
          ],
          "operations": [
            {
              "name": "rankOptions",
              "parameters": [],
              "return_type": "OptionPortfolio"
            }
          ]
        }
      },
      {
        "id": "HOS.Sequence.Execution.EvidenceModeling",
        "type": "execution_occurrence",
        "name": "Exec Evidence",
