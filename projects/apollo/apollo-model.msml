        "do": "CMP-owned; SM RCS; probe-drogue",
        "entry": "dock ~03:20 / extract ~04:09 GET (planned)"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.translunar",
        "name": "translunar",
        "do": "long coast after extract until LOI-1"
      },
