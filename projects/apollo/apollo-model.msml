      {
        "type": "requirement",
        "id": "Apollo.crewSafetyRequirement",
        "name": "Crew Safety",
        "req_id": "REQ-001",
        "text": "An abort path shall remain available\nfrom pad through TEI for the crew.",
        "kind": "safety",
        "priority": "high",
        "status": "draft"
      },
      {
        "type": "requirement",
        "id": "Apollo.landingRequirement",
        "name": "Landing",
        "req_id": "REQ-002",
        "text": "The LM shall land with remaining\ndescent \u0394v margin at the site.",
        "kind": "performance",
        "priority": "high",
        "status": "draft"
      },
      {
        "type": "requirement",
        "id": "Apollo.commsContinuityRequirement",
        "name": "Comms Continuity",
        "req_id": "REQ-003",
        "text": "USB / MSFN shall carry voice and telemetry\nexcept known lunar occultation.",
        "kind": "functional",
        "priority": "high",
        "status": "draft"
      },
      {
        "type": "requirement",
        "id": "Apollo.lesAbortRequirement",
        "name": "LES Abort",
        "req_id": "REQ-004",
        "text": "LES shall pull the CM clear of Saturn\non a pad or ascent abort.",
        "kind": "safety",
        "priority": "high",
        "status": "draft"
      },
      {
        "type": "requirement",
        "id": "Apollo.eclssRequirement",
        "name": "Cabin Atmosphere",
        "req_id": "REQ-005",
        "text": "ECLSS shall maintain a livable cabin\natmosphere for the mission duration.",
        "kind": "safety",
        "priority": "high",
        "status": "draft"
      },
      {
        "type": "requirement",
        "id": "Apollo.guidanceRequirement",
        "name": "Guidance",
        "req_id": "REQ-006",
        "text": "AGC / LGC shall provide GNC; AGS is\nthe LM abort backup. Public architecture only.",
        "kind": "functional",
        "priority": "high",
        "status": "draft"
      },
      {
        "type": "comment",
        "id": "Apollo.Note.Public",
        "name": "Civil / historical NASA public architecture only.\nNo classified or biomedical human-body detail.",
        "text": "Civil / historical NASA public architecture only.\nNo classified or biomedical human-body detail."
      },
