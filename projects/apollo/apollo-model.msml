        "target": "Apollo.State.Mission.entry",
        "name": "EI"
      },
      {
        "id": "stm-apollo.entry-recovery",
        "type": "transition",
        "source": "Apollo.State.Mission.entry",
        "target": "Apollo.State.Mission.recovery",
        "name": "splash"
      },
      {
        "id": "stm-abort.t-init",
        "type": "transition",
        "source": "Apollo.State.Abort.Start",
        "target": "Apollo.State.Abort.pad"
      },
      {
        "id": "stm-abort.I-II",
        "type": "transition",
        "source": "Apollo.State.Abort.I",
        "target": "Apollo.State.Abort.II",
        "name": "Mode II"
      },
      {
        "id": "stm-abort.II-III",
        "type": "transition",
        "source": "Apollo.State.Abort.II",
        "target": "Apollo.State.Abort.III",
        "name": "Mode III"
      },
      {
        "id": "stm-abort.III-IV",
        "type": "transition",
        "source": "Apollo.State.Abort.III",
        "target": "Apollo.State.Abort.IV",
        "name": "Mode IV"
      },
      {
        "id": "stm-apollo.abortPad",
        "type": "transition",
        "source": "Apollo.State.Mission.countdown",
        "target": "Apollo.State.Abort.pad",
        "name": "pad abort"
      },
      {
        "id": "stm-apollo.abortI",
        "type": "transition",
        "source": "Apollo.State.Mission.boost",
        "target": "Apollo.State.Abort.I",
        "name": "Mode I\u2013IV"
      },
      {
        "id": "stm-apollo.abortTLI",
        "type": "transition",
        "source": "Apollo.State.Mission.TLI",
        "target": "Apollo.State.Abort.contingencyTLI",
        "name": "contingency TLI"
      },
      {
        "id": "stm-apollo.abortLunar",
        "type": "transition",
        "source": "Apollo.State.Mission.descent",
        "target": "Apollo.State.Abort.lunar",
        "name": "lunar abort"
      },
      {
        "id": "stm-apollo.abortSPS",
        "type": "transition",
        "source": "Apollo.State.Mission.translunar",
        "target": "Apollo.State.Abort.SPS",
        "name": "SPS abort"
      },
      {
        "id": "stm-apollo.padToRecovery",
        "type": "transition",
        "source": "Apollo.State.Abort.pad",
        "target": "Apollo.State.Mission.recovery",
        "name": "return"
      },
      {
        "id": "stm-apollo.ivToRecovery",
        "type": "transition",
        "source": "Apollo.State.Abort.IV",
        "target": "Apollo.State.Mission.recovery",
        "name": "return"
      },
      {
        "id": "stm-apollo.tliToRecovery",
        "type": "transition",
        "source": "Apollo.State.Abort.contingencyTLI",
        "target": "Apollo.State.Mission.recovery",
        "name": "return"
      },
      {
        "id": "stm-apollo.lunarToRecovery",
        "type": "transition",
        "source": "Apollo.State.Abort.lunar",
        "target": "Apollo.State.Mission.recovery",
        "name": "return"
      },
      {
        "id": "stm-apollo.spsToRecovery",
        "type": "transition",
        "source": "Apollo.State.Abort.SPS",
