      {
        "type": "requirement",
        "id": "Apollo.crewSafetyRequirement",
        "name": "Crew Safety",
        "req_id": "REQ-001",
        "text": "An abort path shall remain available\nfrom pad through TEI for the crew.",
        "kind": "design_constraint",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Apollo.landingRequirement",
        "name": "Landing",
        "req_id": "REQ-002",
        "text": "The LM shall land with remaining\ndescent \u0394v margin at the site.",
        "kind": "performance",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Apollo.commsContinuityRequirement",
        "name": "Comms Continuity",
        "req_id": "REQ-003",
        "text": "USB / MSFN shall carry voice and telemetry\nexcept known lunar occultation.",
        "kind": "functional",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Apollo.lesAbortRequirement",
        "name": "LES Abort",
        "req_id": "REQ-004",
        "text": "LES shall pull the CM clear of Saturn\non a pad or Mode I abort.",
        "kind": "design_constraint",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Apollo.eclssRequirement",
        "name": "Cabin Atmosphere",
        "req_id": "REQ-005",
        "text": "CM ECS: 3 crew / 14 d spec; 5.0 psia 100% O2; CO2 \u22647.6 torr;\nSM O2 640 lb; potable 36 lb / waste 56 lb; LiOH 1.5 man-day, swap 12 h.\nA11 mission 196 h vs 336 h spec.",
        "kind": "design_constraint",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Apollo.guidanceRequirement",
        "name": "Guidance",
        "req_id": "REQ-006",
        "text": "AGC_CM and AGC_LM shall provide GNC;\nAGS is the LM abort backup.",
        "kind": "functional",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "comment",
        "id": "Apollo.Note.Public",
        "name": "Public NASA architecture only.\nNo classified or biomedical human-body detail.",
        "text": "Public NASA architecture only.\nNo classified or biomedical human-body detail."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.Instance",
        "name": "Instance = Apollo 11 / Block II, vehicle AS-506.\nThe modeled stack is the generic Saturn V + CSM + LM\nused by lunar-landing missions.",
        "text": "Instance = Apollo 11 / Block II, vehicle AS-506.\nThe modeled stack is the generic Saturn V + CSM + LM\nused by lunar-landing missions."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.Atypical",
        "name": "Where 11 is atypical (notes only \u2014 not full examples):\n\u2022 Apollo 7 \u2014 no LM\n\u2022 Apollo 8 / Apollo 10 \u2014 no lunar landing\n\u2022 Apollo 13 \u2014 abort, not a completed landing\nDo not stand up those missions as separate projects.",
        "text": "Where 11 is atypical (notes only \u2014 not full examples):\n\u2022 Apollo 7 \u2014 no LM\n\u2022 Apollo 8 / Apollo 10 \u2014 no lunar landing\n\u2022 Apollo 13 \u2014 abort, not a completed landing\nDo not stand up those missions as separate projects."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.Collapse",
        "name": "Do not collapse: two AGCs, AGS (AEA+ASA), IU LVDC,\ndescent vs ascent, LES, DSKY counts (CM 2 / LM 1), EMS.\nOK to collapse: ullage/retro as sets, every verb/noun,\nF-1 hydraulics.",
        "text": "Do not collapse: two AGCs, AGS (AEA+ASA), IU LVDC,\ndescent vs ascent, LES, DSKY counts (CM 2 / LM 1), EMS.\nOK to collapse: ullage/retro as sets, every verb/noun,\nF-1 hydraulics."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.IuOwns",
        "name": "IU owns boost + TLI (LVDC + ST-124 + FCC).\nRSO owns destruct until orbital safing.",
        "text": "IU owns boost + TLI (LVDC + ST-124 + FCC).\nRSO owns destruct until orbital safing."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.UnknownAgsMem",
        "name": "UNKNOWN \u2014 AGS (AEA) memory size.\nAGS is a separate computer. R47 inits it from PNGS.",
        "text": "UNKNOWN \u2014 AGS (AEA) memory size.\nAGS is a separate computer. R47 inits it from PNGS."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.UnknownRope",
        "name": "UNKNOWN \u2014 Apollo 11 Colossus / Luminary rope IDs.\nSoftware family is sourced; rope revision is not.",
        "text": "UNKNOWN \u2014 Apollo 11 Colossus / Luminary rope IDs.\nSoftware family is sourced; rope revision is not."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.UnknownDv",
        "name": "UNKNOWN \u2014 \u0394v table is not on this model.\nDo not invent stage or SPS/DPS/APS \u0394v.",
        "text": "UNKNOWN \u2014 \u0394v table is not on this model.\nDo not invent stage or SPS/DPS/APS \u0394v."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.UnknownTanks",
        "name": "UNKNOWN \u2014 stage tank loads are not on this model.\nDo not invent S-IC / S-II / S-IVB load figures.",
        "text": "UNKNOWN \u2014 stage tank loads are not on this model.\nDo not invent S-IC / S-II / S-IVB load figures."
      },
