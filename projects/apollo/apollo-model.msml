        "type": "block",
        "id": "Apollo.MCC_H",
        "name": "MCC-H",
        "stereotype": "block",
        "compartments": {
          "properties": [
            {
              "name": "site",
              "type": "Houston",
              "multiplicity": "1"
            },
            {
              "name": "contains",
              "type": "MOCR, SSRs, RTCC, CCATS, display/control",
              "multiplicity": "1"
            }
          ],
          "operations": []
        }
      },
      {
        "type": "block",
        "id": "Apollo.MOCR",
        "name": "MOCR",
        "stereotype": "block",
        "compartments": {
          "properties": [
            {
              "name": "consoles",
              "type": "FLIGHT, CAPCOM, EECOM-function, GNC/prop, FDO/RETRO/GUIDO, SURGEON, NETWORK, CCC",
              "multiplicity": "1"
            }
          ],
          "operations": []
        }
      },
      {
        "type": "block",
        "id": "Apollo.FLIGHT",
        "name": "FLIGHT",
        "stereotype": "block",
        "compartments": {
          "properties": [
            {
              "name": "role",
              "type": "flight director",
              "multiplicity": "1"
            }
          ],
          "operations": []
        }
      },
      {
        "type": "block",
        "id": "Apollo.CAPCOM",
        "name": "CAPCOM",
        "stereotype": "block",
        "compartments": {
          "properties": [
            {
