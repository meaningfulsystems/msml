        "name": "boost",
        "do": "IU owns boost"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.earthOrbit",
        "name": "earthOrbit",
        "do": "100 nmi planned"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.TLI",
        "name": "TLI",
        "do": "IU owns TLI \u00b7 PK planned 02:44:15 \u00b7 A11-FP 2:44:26 \u00b7 flown 02:44:16 GET"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.dockEject",
