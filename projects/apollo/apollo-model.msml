        "name": "LOI",
        "do": "LOI-1 75:54:28 GET planned (A11-FP) \u00b7 flown ~075:49:50 GET"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.undock",
        "name": "undock",
        "do": "separateLM()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.DOI",
        "name": "DOI",
        "do": "descentOrbit()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.descent",
        "name": "descent",
        "do": "poweredDescent()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.surfaceEVA",
        "name": "surface/EVA",
        "do": "eva(); collect()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.ascent",
        "name": "ascent",
        "do": "leaveLunarSurface()"
      },
      {
