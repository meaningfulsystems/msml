        "id": "Apollo.State.Mission.TEI",
        "name": "TEI",
        "do": "injectToEarth()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.entry",
        "name": "entry",
        "do": "enterAtmosphere()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.recovery",
        "name": "recovery",
        "do": "splashdown()"
      },
