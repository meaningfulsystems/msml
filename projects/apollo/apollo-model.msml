      {
        "type": "class",
        "id": "Apollo.landingInteraction",
        "name": "landingInteraction"
      },
      {
        "type": "requirement",
        "id": "Apollo.crewSafetyRequirement",
        "name": "Crew Safety",
        "req_id": "REQ-001",
        "text": "An abort path shall remain available\nfrom pad through TEI for the crew.\nNot LES-only.",
        "kind": "design_constraint",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Apollo.landingRequirement",
        "name": "Landing",
        "req_id": "REQ-002",
        "text": "The LM shall land with remaining\ndescent \u0394v margin at the site.",
        "kind": "performance",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Apollo.commsContinuityRequirement",
        "name": "Comms Continuity",
        "req_id": "REQ-003",
        "text": "USB / MSFN shall carry voice and telemetry\nexcept known lunar occultation.",
        "kind": "functional",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Apollo.lesAbortRequirement",
        "name": "LES Abort",
        "req_id": "REQ-004",
        "text": "LES shall pull the CM clear of Saturn\non a pad or Mode I abort.",
        "kind": "design_constraint",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Apollo.eclssRequirement",
        "name": "Cabin Atmosphere",
        "req_id": "REQ-005",
        "text": "CM ECS: 3 crew / 14 d spec; 5.0 psia 100% O2; CO2 \u22647.6 torr;\nSM O2 640 lb; potable 36 lb / waste 56 lb; LiOH 1.5 man-day, swap 12 h.\nA11 mission 196 h vs 336 h spec.",
        "kind": "design_constraint",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Apollo.guidanceRequirement",
        "name": "Guidance",
        "req_id": "REQ-006",
        "text": "AGC_CM and AGC_LM shall provide GNC;\nAGS is the LM abort backup.",
        "kind": "functional",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "comment",
        "id": "Apollo.Note.Public",
        "name": "Public NASA architecture only.\nNo classified or biomedical human-body detail.",
        "text": "Public NASA architecture only.\nNo classified or biomedical human-body detail."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.Instance",
        "name": "Instance = Apollo 11 / Block II, vehicle AS-506.\nThe modeled stack is the generic Saturn V + CSM + LM\nused by lunar-landing missions.",
        "text": "Instance = Apollo 11 / Block II, vehicle AS-506.\nThe modeled stack is the generic Saturn V + CSM + LM\nused by lunar-landing missions."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.Atypical",
        "name": "Where 11 is atypical (notes only \u2014 not full examples):\n\u2022 Apollo 7 \u2014 no LM\n\u2022 Apollo 8 / Apollo 10 \u2014 no lunar landing\n\u2022 Apollo 13 \u2014 abort, not a completed landing\nDo not stand up those missions as separate projects.",
        "text": "Where 11 is atypical (notes only \u2014 not full examples):\n\u2022 Apollo 7 \u2014 no LM\n\u2022 Apollo 8 / Apollo 10 \u2014 no lunar landing\n\u2022 Apollo 13 \u2014 abort, not a completed landing\nDo not stand up those missions as separate projects."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.Collapse",
        "name": "Do not collapse: two AGCs, AGS (AEA+ASA+DEDA), IU LVDC,\ndescent vs ascent, LES, DSKY counts (CM 2 / LM 1), EMS,\nSM fuel cells vs CM AgZn vs LM descent/ascent batteries.\nOK to collapse: ullage/retro as sets, every verb/noun,\nF-1 hydraulics.",
        "text": "Do not collapse: two AGCs, AGS (AEA+ASA+DEDA), IU LVDC,\ndescent vs ascent, LES, DSKY counts (CM 2 / LM 1), EMS,\nSM fuel cells vs CM AgZn vs LM descent/ascent batteries.\nOK to collapse: ullage/retro as sets, every verb/noun,\nF-1 hydraulics."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.IuOwns",
        "name": "Petrone Launch Operations commits launch.\nHandoff Mission Rule 1-21 at umbilical-tower clear.\nAFETR remains parallel destruct. IU owns boost + TLI.",
        "text": "Petrone Launch Operations commits launch.\nHandoff Mission Rule 1-21 at umbilical-tower clear.\nAFETR remains parallel destruct. IU owns boost + TLI."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.AgsSourced",
        "name": "AGS memory is sourced (TN-7990 / NTRS 19750018954).\nAEA: 4096 \u00d7 18-bit, half hardwired / half erasable, 5 \u03bcs.\nDEDA is not a DSKY. Abort-to-orbit / rendezvous only.",
        "text": "AGS memory is sourced (TN-7990 / NTRS 19750018954).\nAEA: 4096 \u00d7 18-bit, half hardwired / half erasable, 5 \u03bcs.\nDEDA is not a DSKY. Abort-to-orbit / rendezvous only."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.UnknownRope",
        "name": "A11 ropes sourced: CMC Comanche 055 / Colossus 2A;\nLGC Luminary 1A LMY99 rev 001. AGS flight-program name UNKNOWN.",
        "text": "A11 ropes sourced: CMC Comanche 055 / Colossus 2A;\nLGC Luminary 1A LMY99 rev 001. AGS flight-program name UNKNOWN."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.UnknownDv",
        "name": "UNKNOWN \u2014 no official CSM lunar \u0394v table.\nDo not invent stage or SPS/DPS/APS \u0394v.",
        "text": "UNKNOWN \u2014 no official CSM lunar \u0394v table.\nDo not invent stage or SPS/DPS/APS \u0394v."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.TanksSourced",
        "name": "Tank loads sourced A11 Press Kit p.109.\nUNRECONCILED \u2014 same flag as \u0394v. Do not treat as a closed mass budget.\nS-IC / S-II / S-IVB / IU / CM 12,250 / SM 51,243 / LM-5 33,205.",
        "text": "Tank loads sourced A11 Press Kit p.109.\nUNRECONCILED \u2014 same flag as \u0394v. Do not treat as a closed mass budget.\nS-IC / S-II / S-IVB / IU / CM 12,250 / SM 51,243 / LM-5 33,205."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.UnknownSmRcs",
        "name": "SM / LM RCS 100 lbf each (A11 PK p.93 / p.106). CM 93 lbf.\nUNKNOWN \u2014 loaded SM/CM RCS propellant mass. Do not invent.",
        "text": "SM / LM RCS 100 lbf each (A11 PK p.93 / p.106). CM 93 lbf.\nUNKNOWN \u2014 loaded SM/CM RCS propellant mass. Do not invent."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.NasmWatts",
        "name": "Fuel-cell watts are NASM secondary (563\u20131420 W normal /\n2300 W max at 27\u201331 V). Press kit does not state watts.",
        "text": "Fuel-cell watts are NASM secondary (563\u20131420 W normal /\n2300 W max at 27\u201331 V). Press kit does not state watts."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.Docking",
        "name": "TD&E is its own GO/NO-GO: CMP-owned, SM RCS, probe-drogue.\nTDE ~03:20\u201304:09 GET planned, then translunar coast until LOI-1 75:54:28 GET (A11-FP planned).\nEarth orbit 100 nmi is planned. TLI \u2192 dockEject \u2192 translunar \u2192 LOI.",
        "text": "TD&E is its own GO/NO-GO: CMP-owned, SM RCS, probe-drogue.\nTDE ~03:20\u201304:09 GET planned, then translunar coast until LOI-1 75:54:28 GET (A11-FP planned).\nEarth orbit 100 nmi is planned. TLI \u2192 dockEject \u2192 translunar \u2192 LOI."
      },
