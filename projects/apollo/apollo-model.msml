      {
        "type": "comment",
        "id": "Apollo.Note.Instance",
        "name": "Instance = Apollo 11 / Block II.\nThe modeled stack is the generic Saturn V + CSM + LM\nused by lunar-landing missions.",
        "text": "Instance = Apollo 11 / Block II.\nThe modeled stack is the generic Saturn V + CSM + LM\nused by lunar-landing missions."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.Atypical",
        "name": "Where 11 is atypical (notes only \u2014 not full examples):\n\u2022 Apollo 7 \u2014 no LM\n\u2022 Apollo 8 / Apollo 10 \u2014 no lunar landing\n\u2022 Apollo 13 \u2014 abort, not a completed landing\nDo not stand up those missions as separate projects tonight.",
        "text": "Where 11 is atypical (notes only \u2014 not full examples):\n\u2022 Apollo 7 \u2014 no LM\n\u2022 Apollo 8 / Apollo 10 \u2014 no lunar landing\n\u2022 Apollo 13 \u2014 abort, not a completed landing\nDo not stand up those missions as separate projects tonight."
      },
