        "target": "Apollo.State.Mission.DOI",
        "name": "DOI"
      },
      {
        "id": "stm-apollo.DOI-descent",
        "type": "transition",
        "source": "Apollo.State.Mission.DOI",
        "target": "Apollo.State.Mission.descent",
        "name": "PDI"
      },
      {
        "id": "stm-apollo.descent-surfaceEVA",
        "type": "transition",
        "source": "Apollo.State.Mission.descent",
        "target": "Apollo.State.Mission.surfaceEVA",
        "name": "touchdown"
      },
      {
        "id": "stm-apollo.surfaceEVA-ascent",
        "type": "transition",
        "source": "Apollo.State.Mission.surfaceEVA",
        "target": "Apollo.State.Mission.ascent",
        "name": "liftoff Moon"
      },
      {
        "id": "stm-apollo.ascent-rendezvous",
        "type": "transition",
        "source": "Apollo.State.Mission.ascent",
        "target": "Apollo.State.Mission.rendezvous",
        "name": "dock"
      },
      {
        "id": "stm-apollo.rendezvous-TEI",
        "type": "transition",
        "source": "Apollo.State.Mission.rendezvous",
