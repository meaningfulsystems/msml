      {
        "type": "comment",
        "id": "Apollo.Note.Serials",
        "name": "SA-506 = S-IC-6 / S-II-6 / S-IVB-6N / IU-6 / SLA-14 / CSM-107 / LM-5.\nNo electrical power between Saturn stages. No CSM\u2013LM propellant crossfeed.",
        "text": "SA-506 = S-IC-6 / S-II-6 / S-IVB-6N / IU-6 / SLA-14 / CSM-107 / LM-5.\nNo electrical power between Saturn stages. No CSM\u2013LM propellant crossfeed."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.Vhf",
        "name": "VHF 296.8 / 259.7 MHz (CSM\u2013LM\u2013EVA).\n243.0 MHz recovery beacon (3 W, 2 s on / 3 s off). USB numbers unchanged.",
        "text": "VHF 296.8 / 259.7 MHz (CSM\u2013LM\u2013EVA).\n243.0 MHz recovery beacon (3 W, 2 s on / 3 s off). USB numbers unchanged."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.CryoA11",
        "name": "A11 SM cryo is 2 H2 + 2 O2.\nNot J-mission third O2 / SM aux battery / SIM bay / rover.",
        "text": "A11 SM cryo is 2 H2 + 2 O2.\nNot J-mission third O2 / SM aux battery / SIM bay / rover."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.EvaTimes",
        "name": "A11 EVA: CDR 2:48, LMP 2:40 (PAO walk 2:31:37).",
        "text": "A11 EVA: CDR 2:48, LMP 2:40 (PAO walk 2:31:37)."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.DescentO2Psi",
        "name": "TN D-6724 conflicts 2800 vs 3000 psi on descent O2 \u2014 cite both.",
        "text": "TN D-6724 conflicts 2800 vs 3000 psi on descent O2 \u2014 cite both."
      },
      {
        "type": "value_property",
        "id": "Apollo.PAR.foodMass",
        "name": "2.26 lb/man/day planned",
        "value_type": "Real",
        "unit": "lb/man/day"
      },
      {
        "type": "comment",
        "id": "Apollo.Note.TdeTimes",
        "name": "TLI PK planned 02:44:15 GET \u2192 TDE ~03:20\u201304:09 planned \u2192 translunar coast until LOI-1 75:54:28 GET (A11-FP planned). TLI \u2192 dockEject \u2192 translunar \u2192 LOI (not translunar then dockEject).",
        "text": "TLI PK planned 02:44:15 GET \u2192 TDE ~03:20\u201304:09 planned \u2192 translunar coast until LOI-1 75:54:28 GET (A11-FP planned). TLI \u2192 dockEject \u2192 translunar \u2192 LOI (not translunar then dockEject)."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.GetPlannedFlown",
        "name": "GET: planned vs flown. Earth orbit 100 nmi is planned.\nTLI three labels: PK planned 02:44:15; A11-FP 2:44:26; flown 02:44:16 (no 02:44:16.2). TDE ~03:20\u201304:09 GET planned. LOI-1 two strings only: 75:54:28 GET A11-FP planned (do not cite Press Kit as the LOI-1 source); flown ~075:49:50 GET. Splash 195:18:35 MET is on Recovery (sourced MET, not labeled flown).",
        "text": "GET: planned vs flown. Earth orbit 100 nmi is planned.\nTLI three labels: PK planned 02:44:15; A11-FP 2:44:26; flown 02:44:16 (no 02:44:16.2). TDE ~03:20\u201304:09 GET planned. LOI-1 two strings only: 75:54:28 GET A11-FP planned (do not cite Press Kit as the LOI-1 source); flown ~075:49:50 GET. Splash 195:18:35 MET is on Recovery (sourced MET, not labeled flown)."
      }
    ],
