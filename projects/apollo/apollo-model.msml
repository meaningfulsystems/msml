      {
        "type": "initial_pseudostate",
        "id": "Apollo.State.Mission.Start",
        "name": "Start"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.countdown",
        "name": "countdown",
        "do": "hold(); pollGo()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.boost",
        "name": "boost",
        "do": "leaveEarth()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.earthOrbit",
        "name": "earthOrbit",
        "do": "coastEO()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.TLI",
        "name": "TLI",
        "do": "injectToMoon()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.translunar",
        "name": "translunar",
        "do": "coastTLI()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.LOI",
        "name": "LOI",
        "do": "captureLunarOrbit()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.undock",
        "name": "undock",
        "do": "separateLM()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.DOI",
        "name": "DOI",
        "do": "descentOrbit()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.descent",
        "name": "descent",
        "do": "poweredDescent()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.surfaceEVA",
        "name": "surface/EVA",
        "do": "eva(); collect()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.ascent",
        "name": "ascent",
        "do": "leaveLunarSurface()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.rendezvous",
        "name": "rendezvous",
        "do": "dockCSM()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.TEI",
        "name": "TEI",
        "do": "injectToEarth()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.entry",
        "name": "entry",
        "do": "enterAtmosphere()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Mission.recovery",
        "name": "recovery",
        "do": "splashdown()"
      },
      {
        "type": "initial_pseudostate",
        "id": "Apollo.State.Abort.Start",
        "name": "AbortStart"
      },
      {
        "type": "state",
        "id": "Apollo.State.Abort.pad",
        "name": "pad",
        "do": "LES(); towerClear()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Abort.I",
        "name": "I",
        "do": "Mode I LES()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Abort.II",
        "name": "II",
        "do": "Mode II()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Abort.III",
        "name": "III",
        "do": "Mode III()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Abort.IV",
        "name": "IV",
        "do": "Mode IV()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Abort.contingencyTLI",
        "name": "contingencyTLI",
        "do": "noTLI(); return()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Abort.lunar",
        "name": "lunar",
        "do": "AGS(); APS()"
      },
      {
        "type": "state",
        "id": "Apollo.State.Abort.SPS",
        "name": "SPS",
        "do": "SPS abort()"
      },
