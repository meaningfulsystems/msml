      {
        "type": "comment",
        "id": "Apollo.Note.AgcLvdc",
        "name": "AGC does not talk digital to LVDC.\nCMC only monitors (P11/P15); analog backup steer never used in flight.",
        "text": "AGC does not talk digital to LVDC.\nCMC only monitors (P11/P15); analog backup steer never used in flight."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.EngineConflict",
        "name": "Cite both: SPS 20,500 (PK) vs 21,500 vac (TN D-7375);\nDPS 9,870 / 1,050\u20136,300 (PK) vs 10,500 and 10:1 (TN D-7143).",
        "text": "Cite both: SPS 20,500 (PK) vs 21,500 vac (TN D-7375);\nDPS 9,870 / 1,050\u20136,300 (PK) vs 10,500 and 10:1 (TN D-7143)."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.UnknownSpsLoad",
        "name": "UNKNOWN \u2014 CSM-107 SPS loaded lb.\nBlock II O/F 1.6 is sourced; loaded mass is not.",
        "text": "UNKNOWN \u2014 CSM-107 SPS loaded lb.\nBlock II O/F 1.6 is sourced; loaded mass is not."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.PNumbers",
        "name": "P-numbers are not global. CMC P61\u2013P67 = ENTRY.\nLGC P63\u2013P68 = LANDING. Do not share one STM.",
        "text": "P-numbers are not global. CMC P61\u2013P67 = ENTRY.\nLGC P63\u2013P68 = LANDING. Do not share one STM."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.ProgramAlarm",
        "name": "V37 change mode; V36 fresh start; V69 restart.\n1201/1202 = exec overflow + software restart, NOT an abort (A11 RR).",
        "text": "V37 change mode; V36 fresh start; V69 restart.\n1201/1202 = exec overflow + software restart, NOT an abort (A11 RR)."
      },
