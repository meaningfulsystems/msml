      {
        "type": "requirement",
        "id": "Apollo.crewSafetyRequirement",
        "name": "Crew Safety",
        "req_id": "REQ-001",
        "text": "An abort path shall remain available\nfrom pad through TEI for the crew.",
        "kind": "design_constraint",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Apollo.landingRequirement",
        "name": "Landing",
        "req_id": "REQ-002",
        "text": "The LM shall land with remaining\ndescent \u0394v margin at the site.",
        "kind": "performance",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Apollo.commsContinuityRequirement",
        "name": "Comms Continuity",
        "req_id": "REQ-003",
        "text": "USB / MSFN shall carry voice and telemetry\nexcept known lunar occultation.",
        "kind": "functional",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Apollo.lesAbortRequirement",
        "name": "LES Abort",
        "req_id": "REQ-004",
        "text": "LES shall pull the CM clear of Saturn\non a pad or Mode I abort.",
        "kind": "design_constraint",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Apollo.eclssRequirement",
        "name": "Cabin Atmosphere",
        "req_id": "REQ-005",
        "text": "ECLSS shall maintain a livable cabin\natmosphere for the mission duration.",
        "kind": "design_constraint",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Apollo.guidanceRequirement",
        "name": "Guidance",
        "req_id": "REQ-006",
        "text": "AGC_CM and AGC_LM shall provide GNC;\nAGS is the LM abort backup.",
        "kind": "functional",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "comment",
        "id": "Apollo.Note.Public",
        "name": "Public NASA architecture only.\nNo classified or biomedical human-body detail.",
        "text": "Public NASA architecture only.\nNo classified or biomedical human-body detail."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.Instance",
        "name": "Instance = Apollo 11 / Block II.\nThe modeled stack is the generic Saturn V + CSM + LM\nused by lunar-landing missions.",
        "text": "Instance = Apollo 11 / Block II.\nThe modeled stack is the generic Saturn V + CSM + LM\nused by lunar-landing missions."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.Atypical",
        "name": "Where 11 is atypical (notes only \u2014 not full examples):\n\u2022 Apollo 7 \u2014 no LM\n\u2022 Apollo 8 / Apollo 10 \u2014 no lunar landing\n\u2022 Apollo 13 \u2014 abort, not a completed landing\nDo not stand up those missions as separate projects.",
        "text": "Where 11 is atypical (notes only \u2014 not full examples):\n\u2022 Apollo 7 \u2014 no LM\n\u2022 Apollo 8 / Apollo 10 \u2014 no lunar landing\n\u2022 Apollo 13 \u2014 abort, not a completed landing\nDo not stand up those missions as separate projects."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.Collapse",
        "name": "Kept distinct: AGC_CM, AGC_LM, DSKY, AGS, IU LVDC, USB.\nCollapsed: engine hydraulics; MSFN ships (stations only).",
        "text": "Kept distinct: AGC_CM, AGC_LM, DSKY, AGS, IU LVDC, USB.\nCollapsed: engine hydraulics; MSFN ships (stations only)."
      },
