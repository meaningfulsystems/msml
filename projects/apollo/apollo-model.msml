      {
        "type": "comment",
        "id": "Apollo.Note.UnknownRtcc",
        "name": "UNKNOWN: which IBM 360/75 is MOC vs DSC on A11.",
        "text": "UNKNOWN: which IBM 360/75 is MOC vs DSC on A11."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.UnknownAis",
        "name": "UNKNOWN: identity of the 4th AIS ship.",
        "text": "UNKNOWN: identity of the 4th AIS ship."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.CmpNoEva",
        "name": "CMP: no PLSS + OPS. EVA equipment is CDR / LMP only.",
        "text": "CMP: no PLSS + OPS. EVA equipment is CDR / LMP only."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.UnknownFood",
        "name": "D-7720 April 1967 plan: 2800 kcal/man/day CM, 3200 LM.\n2.26 lb/man/day planned. Not A11 flown intake. A11 actual kcal still UNKNOWN.",
        "text": "D-7720 April 1967 plan: 2800 kcal/man/day CM, 3200 LM.\n2.26 lb/man/day planned. Not A11 flown intake. A11 actual kcal still UNKNOWN."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.UnknownBlackout",
        "name": "Lunar delay = range/c (~1.3 s). Entry blackout duration UNKNOWN.",
        "text": "Lunar delay = range/c (~1.3 s). Entry blackout duration UNKNOWN."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.AntennaSelect",
        "name": "Block II antennas are CREW-selected, not ground-commandable.",
        "text": "Block II antennas are CREW-selected, not ground-commandable."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.RsoOutside",
        "name": "RSO / AFETR are OUTSIDE MCC. UHF destruct. Safed after Earth orbit.",
        "text": "RSO / AFETR are OUTSIDE MCC. UHF destruct. Safed after Earth orbit."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.Ft30",
        "name": "Named 30-ft only. Do not merge GSFC-1968 and TN D-6723 into \u201cthe 14\u201d.",
        "text": "Named 30-ft only. Do not merge GSFC-1968 and TN D-6723 into \u201cthe 14\u201d."
      },
      {
        "type": "comment",
        "id": "Apollo.Note.CommandPaths",
        "name": "Path A: FC\u2192CCC\u2192RTCC\u2192CCATS\u2192site 642B\u2192USB 70 kHz.\nPath B: P27 V70\u2013V73 into CMC/LGC. Distinct paths.",
        "text": "Path A: FC\u2192CCC\u2192RTCC\u2192CCATS\u2192site 642B\u2192USB 70 kHz.\nPath B: P27 V70\u2013V73 into CMC/LGC. Distinct paths."
      },
      {
        "type": "requirement",
        "id": "Apollo.usbRfRequirement",
        "name": "USB RF (sourced)",
        "req_id": "REQ-007",
        "text": "CSM 2106.40625 \u2191 / 2287.5 PM \u2193 / 2272.5 FM;\nLM 2101.802 \u2191 / 2282.5. PCM 51.2 or 1.6 kbps.\nUplink digital ~2 kbps. PRN range 992 kbps, \u00b115 m,\n~540,000 mi unambiguous.",
        "kind": "interface",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Apollo.p27Requirement",
        "name": "P27 uplink verbs",
        "req_id": "REQ-008",
        "text": "P27 uplink verbs ONLY V70\u2013V73 into CMC/LGC.\nSeparate from the CCATS command-load path.",
        "kind": "interface",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Apollo.foodRequirement",
        "name": "Food plan (D-7720)",
        "req_id": "REQ-009",
        "text": "D-7720 April 1967 plan baseline: 2800 kcal/man/day CM, 3200 kcal/man/day LM.\nMass 2.26 lb/man/day planned. 1967 plan, not A11 flown intake.\nA11 actual kcal still UNKNOWN.",
        "kind": "design_constraint",
        "priority": "medium",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Apollo.lmEcsRequirement",
        "name": "LM-5 ECS (sourced)",
        "req_id": "REQ-010",
        "text": "LM-5: descent O2 ~48 lb @ 2800 vs 3000 psi (TN D-6724 \u2014 cite both);\nascent O2 ~2.4 lb \u00d72; descent water 332 lb; ascent water 42 lb \u00d72;\nLCG 1200 Btu/man-h steady.",
        "kind": "design_constraint",
        "priority": "high",
        "status": "approved"
      },
