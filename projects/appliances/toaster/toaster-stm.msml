{
  "msml_version": "1.0",
  "diagram": {
    "type": "state_machine",
    "id": "stm-toaster",
    "name": "Toaster",
    "context": "Appliance",
    "frame": {
      "visible": true,
      "style": {
        "border_color": "#333333",
        "border_width": 1.5,
        "border_style": "solid",
        "fill_color": "#FFFFFF",
        "tab": {
          "fill_color": "#FFFFFF",
          "border_color": "#333333",
          "padding_x": 8,
          "padding_y": 4,
          "font": {
            "family": "Arial",
            "size": 11,
            "bold": false,
            "italic": false,
            "color": "#000000"
          }
        }
      }
    },
    "canvas": {
      "width": 900,
      "height": 360,
      "background_color": "#FAFAFA",
      "grid": {
        "enabled": true,
        "size": 10,
        "snap": true
      }
    },
    "elements": [
      {
        "type": "initial_pseudostate",
        "id": "init",
        "name": "",
        "layout": {
          "x": 440,
          "y": 20,
          "width": 20,
          "height": 20,
          "z_index": 1
        },
        "style": {
          "fill_color": "#000000"
        }
      },
      {
        "type": "state",
        "id": "state-idle",
        "name": "Idle",
        "layout": {
          "x": 320,
          "y": 65,
          "width": 260,
          "height": 60,
          "z_index": 1
        },
        "style": {
          "fill_color": "#E8F4FD",
          "border_color": "#2E86AB",
          "border_width": 2,
          "border_style": "solid",
          "corner_radius": 8,
          "font": {
            "family": "Arial",
            "size": 13,
            "bold": true,
            "color": "#1A1A2E"
          }
        },
        "model_ref": "Toaster.STM.Idle"
      },
      {
        "type": "state",
        "id": "state-toasting",
        "name": "Toasting",
        "entry": "start_timer()",
        "do": "heat_element()",
        "exit": "stop_timer()",
        "layout": {
          "x": 320,
          "y": 205,
          "width": 260,
          "height": 110,
          "z_index": 1
        },
        "style": {
          "fill_color": "#FFF3E0",
          "border_color": "#E65100",
          "border_width": 2,
          "border_style": "solid",
          "corner_radius": 8,
          "font": {
            "family": "Arial",
            "size": 13,
            "bold": true,
            "color": "#1A1A2E"
          }
        },
        "model_ref": "Toaster.STM.Toasting"
      },
      {
        "type": "state",
        "id": "state-done",
        "name": "Done",
        "entry": "pop_carriage()",
        "layout": {
          "x": 630,
          "y": 220,
          "width": 200,
          "height": 80,
          "z_index": 1
        },
        "style": {
          "fill_color": "#E8F5E9",
          "border_color": "#2E7D32",
          "border_width": 2,
          "border_style": "solid",
          "corner_radius": 8,
          "font": {
            "family": "Arial",
            "size": 13,
            "bold": true,
            "color": "#1A1A2E"
          }
        },
        "model_ref": "Toaster.STM.Done"
      },
      {
        "type": "state",
        "id": "state-error",
        "name": "Error",
        "entry": "deactivate_element(); release_latch(); sound_alarm()",
        "layout": {
          "x": 70,
          "y": 220,
          "width": 200,
          "height": 80,
          "z_index": 1
        },
        "style": {
          "fill_color": "#FFEBEE",
          "border_color": "#C62828",
          "border_width": 2,
          "border_style": "solid",
          "corner_radius": 8,
          "font": {
            "family": "Arial",
            "size": 13,
            "bold": true,
            "color": "#1A1A2E"
          }
        },
        "model_ref": "Toaster.STM.Error"
      }
    ],
    "relationships": [
      {
        "type": "transition",
        "id": "t-init-idle",
        "source": "init",
        "target": "state-idle",
        "waypoints": [
          {
            "x": 450,
            "y": 40
          },
          {
            "x": 450,
            "y": 65
          }
        ],
        "style": {
          "line_color": "#333333",
          "line_width": 1.5,
          "line_style": "solid",
          "arrowhead": "open",
          "label_offset": {
            "x": 0,
            "y": 0
          }
        }
      },
      {
        "type": "transition",
        "id": "t-idle-toasting",
        "source": "state-idle",
        "target": "state-toasting",
        "trigger": "lever_down",
        "waypoints": [
          {
            "x": 450,
            "y": 125
          },
          {
            "x": 450,
            "y": 205
          }
        ],
        "style": {
          "line_color": "#333333",
          "line_width": 1.5,
          "line_style": "solid",
          "arrowhead": "open",
          "label_offset": {
            "x": 8,
            "y": 0
          }
        }
      },
      {
        "type": "transition",
        "id": "t-toasting-idle",
        "source": "state-toasting",
        "target": "state-idle",
        "trigger": "lever_up",
        "waypoints": [
          {
            "x": 372,
            "y": 205
          },
          {
            "x": 372,
            "y": 125
          }
        ],
        "style": {
          "line_color": "#555555",
          "line_width": 1.5,
          "line_style": "dashed",
          "arrowhead": "open",
          "label_offset": {
            "x": 8,
            "y": 0
          }
        }
      },
      {
        "type": "transition",
        "id": "t-toasting-done",
        "source": "state-toasting",
        "target": "state-done",
        "trigger": "timer_expired",
        "waypoints": [
          {
            "x": 580,
            "y": 260
          },
          {
            "x": 630,
            "y": 260
          }
        ],
        "style": {
          "line_color": "#333333",
          "line_width": 1.5,
          "line_style": "solid",
          "arrowhead": "open",
          "label_offset": {
            "x": 0,
            "y": -18
          }
        }
      },
      {
        "type": "transition",
        "id": "t-toasting-error",
        "source": "state-toasting",
        "target": "state-error",
        "trigger": "overheat_detected",
        "waypoints": [
          {
            "x": 320,
            "y": 260
          },
          {
            "x": 270,
            "y": 260
          }
        ],
        "style": {
          "line_color": "#C62828",
          "line_width": 1.5,
          "line_style": "solid",
          "arrowhead": "open",
          "label_offset": {
            "x": 0,
            "y": -18
          }
        }
      },
      {
        "type": "transition",
        "id": "t-error-idle",
        "source": "state-error",
        "target": "state-idle",
        "trigger": "reset",
        "waypoints": [
          {
            "x": 170,
            "y": 220
          },
          {
            "x": 170,
            "y": 50
          },
          {
            "x": 320,
            "y": 50
          },
          {
            "x": 320,
            "y": 71
          }
        ],
        "style": {
          "line_color": "#C62828",
          "line_width": 1.5,
          "line_style": "dashed",
          "arrowhead": "open",
          "label_offset": {
            "x": 0,
            "y": 0
          }
        }
      },
      {
        "type": "transition",
        "id": "t-done-idle",
        "source": "state-done",
        "target": "state-idle",
        "trigger": "toast_removed",
        "waypoints": [
          {
            "x": 730,
            "y": 220
          },
          {
            "x": 730,
            "y": 50
          },
          {
            "x": 580,
            "y": 50
          },
          {
            "x": 580,
            "y": 71
          }
        ],
        "style": {
          "line_color": "#333333",
          "line_width": 1.5,
          "line_style": "solid",
          "arrowhead": "open",
          "label_offset": {
            "x": 0,
            "y": 0
          }
        }
      }
    ],
    "metadata": {
      "author": "Andrew Fried",
      "created": "2026-05-16",
      "modified": "2026-05-17",
      "tags": [
        "toaster",
        "state-machine",
        "appliance"
      ]
    }
  }
}