        "text": "Heating element shall reach\ntarget temp within 30s.",
        "kind": "performance", "priority": "high", "status": "approved",
        "model_ref": "Toaster.REQ-001.1",
        "layout": { "x": 20, "y": 220, "width": 230, "height": 110, "z_index": 1 },
        "style": { "fill_color": "#FFEDE0", "border_color": "#CC4400", "border_width": 2, "font": { "size": 11, "color": "#000000" } }
      },
      {
        "type": "requirement", "id": "req-001-2",
        "name": "Timer Function", "req_id": "REQ-001.2",
        "text": "Timer shall support 1–5 min\nbrowning settings.",
