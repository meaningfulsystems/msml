        "layout": { "x": 270, "y": 220, "width": 230, "height": 110, "z_index": 1 },
        "style": { "fill_color": "#FFF8DC", "border_color": "#8B6914", "border_width": 2, "font": { "size": 11, "color": "#000000" } }
      },
      {
        "type": "requirement", "id": "req-001-3",
