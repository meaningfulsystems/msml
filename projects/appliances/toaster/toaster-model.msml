      {
        "type": "class",
        "id": "Toaster.Parametric",
        "name": "Parametric"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-001",
        "name": "Toasting Capability",
        "req_id": "REQ-001",
        "text": "System shall toast bread\nto user-selected browning.",
        "kind": "functional",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-001.1",
        "name": "Heat Control",
        "req_id": "REQ-001.1",
        "text": "Heating element shall reach\ntarget temp within 30s.",
        "kind": "performance",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-001.2",
        "name": "Timer Function",
        "req_id": "REQ-001.2",
        "text": "Timer shall support 1\u20135 min\nbrowning settings.",
        "kind": "functional",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-001.3",
        "name": "Carriage Mechanism",
        "req_id": "REQ-001.3",
        "text": "Carriage shall pop toast\nupon timer completion.",
        "kind": "functional",
        "priority": "medium",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-001.4",
        "name": "Browning Repeatability",
        "req_id": "REQ-001.4",
        "text": "Same browning level shall\nproduce \u00b15% energy variance.",
        "kind": "performance",
        "priority": "medium",
        "status": "proposed"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-002",
        "name": "Safety",
        "req_id": "REQ-002",
        "text": "System shall detect overheat\nand shut down automatically.",
        "kind": "design_constraint",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-002.1",
        "name": "Overheat Detection",
        "req_id": "REQ-002.1",
        "text": "ThermalCutoff shall trip\nbelow 300\u00b0C surface temp.",
        "kind": "functional",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-002.2",
        "name": "Auto Shutoff",
        "req_id": "REQ-002.2",
        "text": "On trip: deactivate element\nand release carriage latch.",
        "kind": "functional",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-003",
        "name": "User Controls",
        "req_id": "REQ-003",
        "text": "User shall control browning\nlevel and cancel toasting.",
        "kind": "functional",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-003.1",
        "name": "Cancel / Eject",
        "req_id": "REQ-003.1",
        "text": "Lever-up during toasting\nshall cancel and eject.",
        "kind": "functional",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "class",
        "id": "Toaster.Requirements",
        "name": "Requirements"
      },
      {
        "type": "class",
        "id": "Toaster.STM",
        "name": "ToasterSTM"
      },
      {
        "type": "state",
        "id": "Toaster.STM.Done",
        "name": "Done",
        "entry": "pop_carriage()"
      },
      {
        "type": "state",
        "id": "Toaster.STM.Error",
        "name": "Error",
        "entry": "deactivate_element(); release_latch(); sound_alarm()"
      },
      {
        "type": "state",
        "id": "Toaster.STM.Idle",
        "name": "Idle"
      },
      {
        "type": "state",
        "id": "Toaster.STM.Toasting",
        "name": "Toasting",
        "entry": "start_timer()",
        "do": "heat_element()",
        "exit": "stop_timer()"
      },
