      {
        "type": "class",
        "id": "Toaster.Parametric",
        "name": "Parametric"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-001",
        "name": "Toasting Capability",
        "req_id": "REQ-001",
        "text": "System shall toast bread\nto user-selected browning.",
        "kind": "functional",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-001.1",
        "name": "Heat Control",
        "req_id": "REQ-001.1",
        "text": "Heating element shall reach\ntarget temp within 30s.",
        "kind": "performance",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-001.2",
        "name": "Timer Function",
        "req_id": "REQ-001.2",
        "text": "Timer shall support 1–5 min\nbrowning settings.",
        "kind": "functional",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-001.3",
        "name": "Carriage Mechanism",
        "req_id": "REQ-001.3",
        "text": "Carriage shall pop toast\nupon timer completion.",
        "kind": "functional",
        "priority": "medium",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-001.4",
        "name": "Browning Repeatability",
        "req_id": "REQ-001.4",
        "text": "Same browning level shall\nproduce ±5% energy variance.",
        "kind": "performance",
        "priority": "medium",
        "status": "proposed"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-002",
        "name": "Safety",
        "req_id": "REQ-002",
        "text": "System shall detect overheat\nand shut down automatically.",
        "kind": "design_constraint",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-002.1",
        "name": "Overheat Detection",
        "req_id": "REQ-002.1",
        "text": "ThermalCutoff shall trip\nbelow 300°C surface temp.",
        "kind": "functional",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-002.2",
        "name": "Auto Shutoff",
        "req_id": "REQ-002.2",
        "text": "On trip: deactivate element\nand release carriage latch.",
        "kind": "functional",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-003",
        "name": "User Controls",
        "req_id": "REQ-003",
        "text": "User shall control browning\nlevel and cancel toasting.",
        "kind": "functional",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "Toaster.REQ-003.1",
        "name": "Cancel / Eject",
        "req_id": "REQ-003.1",
        "text": "Lever-up during toasting\nshall cancel and eject.",
        "kind": "functional",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "class",
        "id": "Toaster.Requirements",
