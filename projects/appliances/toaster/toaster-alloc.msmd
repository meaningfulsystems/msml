{
  "msml_version": "1.0",
  "model_files": [
    "toaster-model.msml"
  ],
  "diagram": {
    "type": "allocation_table",
    "id": "alloc-toaster",
    "name": "Toaster Allocation Table",
    "context": "Appliance",
    "frame": {
      "visible": true,
      "style": {
        "border_color": "#333333",
        "border_width": 1.5,
        "tab": {
          "fill_color": "#FFFFFF",
          "border_color": "#333333",
          "padding_x": 8,
          "padding_y": 4,
          "font": {
            "size": 11,
            "color": "#000000"
          }
        }
      }
    },
    "canvas": {
      "width": 860,
      "height": 370,
      "background_color": "#FAFAFA",
      "grid": {
        "enabled": true,
        "size": 10,
        "snap": true
      }
    },
    "table": {
      "layout": {
        "x": 20,
        "y": 20,
        "width": 820,
        "height": 330
      },
      "header_height": 34,
      "row_height": 32,
      "header_fill": "#2E4057",
      "header_color": "#FFFFFF",
      "alt_fill": "#F4F7FB",
      "row_fill": "#FFFFFF",
      "grid_color": "#5A6570",
      "text_color": "#1A1A1A",
      "columns": [
        {"key": "source", "label": "Allocated From", "width": 210},
        {"key": "source_type", "label": "From Type", "width": 120},
        {"key": "target", "label": "Allocated To", "width": 210},
        {"key": "target_type", "label": "To Type", "width": 120},
        {"key": "kind", "label": "Kind", "width": 160}
      ]
    },
    "elements": [],
    "relationships": [
      {"id": "row-insert", "relationship_ref": "alloc-toaster.insert-carriage"},
      {"id": "row-lever", "relationship_ref": "alloc-toaster.lever-press"},
      {"id": "row-timer", "relationship_ref": "alloc-toaster.start-timer"},
      {"id": "row-heat", "relationship_ref": "alloc-toaster.heat-element"},
      {"id": "row-pop", "relationship_ref": "alloc-toaster.pop-carriage"},
      {"id": "row-toasting", "relationship_ref": "alloc-toaster.toasting-toaster"},
      {"id": "row-error", "relationship_ref": "alloc-toaster.error-cutoff"},
      {"id": "row-uc-toast", "relationship_ref": "alloc-toaster.uc-toast"},
      {"id": "row-uc-heat", "relationship_ref": "alloc-toaster.uc-heat"}
    ],
