      {
        "type": "class",
        "id": "ElectricBike.startRideInteraction",
        "name": "startRideInteraction"
      },
      {
        "type": "requirement",
        "id": "ElectricBike.rideSafetyRequirement",
        "name": "Ride Safety",
        "req_id": "REQ-001",
        "text": "Motor shall fail silent: brake inhibit, controller,\ncadence sensor, and BMS. Not brakes-only.",
        "kind": "safety",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "ElectricBike.rangeRequirement",
        "name": "Range (\u2265 60 km Tour)",
        "req_id": "REQ-002",
        "text": "Tour 60 km via usableWh 500 Wh / energyPerKm\n~8.3 Wh/km. Not Eco / PAS-1.",
        "kind": "performance",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "ElectricBike.assistLimitRequirement",
        "name": "Assist Limit (25 km/h)",
        "req_id": "REQ-003",
        "text": "EPAC / EN 15194: cadence-only assist,\ncut off at 25 km/h (wheel speed). No throttle.",
        "kind": "design_constraint",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "ElectricBike.chargeSafetyRequirement",
        "name": "Charge Safety",
        "req_id": "REQ-004",
        "text": "Charging shall stop on over-temp,\nover-voltage, or charger disconnect.\nBMS inside the pack opens the contactor.",
        "kind": "safety",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "ElectricBike.brakeOverrideRequirement",
        "name": "Brake Override (50 ms)",
        "req_id": "REQ-005",
        "text": "Motor inhibit shall assert within 50 ms of either\nbrake lever. Electronic order; ~10\u00d7 tighter than EN 15194.",
        "kind": "performance",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "ElectricBike.batteryCutoffRequirement",
        "name": "Battery Cutoff",
        "req_id": "REQ-006",
        "text": "BMS inside the pack shall open the\ncontactor before any cell exceeds its V/T limit.",
        "kind": "safety",
        "priority": "high",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "ElectricBike.displayRequirement",
        "name": "Display",
        "req_id": "REQ-007",
        "text": "Rider shall see speed, assist level,\nand remaining range hands-on-bars.",
        "kind": "functional",
        "priority": "medium",
        "status": "approved"
      },
      {
        "type": "requirement",
        "id": "ElectricBike.structuralRequirement",
        "name": "Structural",
        "req_id": "REQ-008",
        "text": "Frame shall carry rider, cargo, and\nbattery loads without yielding.",
        "kind": "design_constraint",
        "priority": "high",
        "status": "approved"
      },
      {
        "id": "ElectricBike.PAR.energyBalance",
        "type": "constraint_property",
        "name": "usableWh \u2265 energyPerKm \u00d7 60 km Tour",
        "expression": "packEnergy >= energyPerKm * 60",
        "parameters": [
          {
            "name": "packEnergy",
            "type": "Wh"
          },
          {
            "name": "energyPerKm",
            "type": "Wh/km"
          }
        ]
      },
      {
        "id": "ElectricBike.PAR.rangeEstimate",
        "type": "constraint_property",
        "name": "rangeKm = E_pack / e_km",
        "expression": "rangeKm = packEnergy / energyPerKm",
        "parameters": [
          {
            "name": "packEnergy",
            "type": "Wh"
          },
          {
            "name": "energyPerKm",
            "type": "Wh/km"
          },
          {
            "name": "rangeKm",
            "type": "km"
          }
        ]
      },
      {
        "id": "ElectricBike.PAR.assistPowerLimit",
        "type": "constraint_property",
        "name": "P_assist = 0 if v \u2265 25 km/h",
        "expression": "assistPower = 0 if speed >= cutoffSpeed",
        "parameters": [
          {
            "name": "assistPower",
            "type": "W"
          },
          {
            "name": "cutoffSpeed",
            "type": "km/h"
          }
        ]
      },
      {
        "id": "ElectricBike.PAR.brakeLatencyLimit",
        "type": "constraint_property",
        "name": "t_brake \u2264 50 ms",
        "expression": "brakeLatency <= 50 ms",
        "parameters": [
          {
            "name": "brakeLatency",
            "type": "ms"
          }
        ]
      },
      {
        "type": "value_property",
        "id": "ElectricBike.PAR.packEnergy",
        "name": "usableWh: 500 Wh Tour",
        "value_type": "Real",
        "unit": "Wh"
      },
      {
        "type": "value_property",
        "id": "ElectricBike.PAR.riderPower",
        "name": "riderPower: W",
        "value_type": "Real",
        "unit": "W"
      },
      {
        "type": "value_property",
        "id": "ElectricBike.PAR.assistPower",
        "name": "assistPower: W",
        "value_type": "Real",
        "unit": "W"
      },
      {
        "type": "value_property",
        "id": "ElectricBike.PAR.rangeKm",
        "name": "rangeKm: \u2265 60 km",
        "value_type": "Real",
        "unit": "km"
      },
      {
        "type": "value_property",
        "id": "ElectricBike.PAR.cutoffSpeed",
        "name": "cutoffSpeed: 25 km/h",
        "value_type": "Real",
        "unit": "km/h"
      },
      {
        "type": "value_property",
        "id": "ElectricBike.PAR.brakeLatency",
