      {
        "type": "class",
        "id": "ElectricBike.RideControl",
        "name": "RideControl"
      },
      {
        "id": "ElectricBike.State.RideControl.Start",
        "type": "initial_pseudostate",
        "name": "Init"
      },
      {
        "type": "state",
        "id": "ElectricBike.State.RideControl.off",
        "name": "off"
      },
      {
        "type": "state",
        "id": "ElectricBike.State.RideControl.standby",
        "name": "standby",
        "entry": "enableSensors()"
      },
      {
        "type": "state",
        "id": "ElectricBike.State.RideControl.assist",
        "name": "assist",
        "do": "modulateTorque()",
        "exit": "zeroAssist()"
      },
      {
        "type": "state",
        "id": "ElectricBike.State.RideControl.charging",
        "name": "charging",
        "do": "acceptCharge()  // EPAC: from Off only"
      },
      {
        "type": "state",
        "id": "ElectricBike.State.RideControl.fault",
        "name": "fault",
        "entry": "inhibitMotor();\nopenContactor()"
      },
      {
        "type": "state",
        "id": "ElectricBike.State.RideControl.walk",
        "name": "walk",
        "do": "limitSpeed(<= 6 km/h)",
        "exit": "zeroAssist()"
      },
      {
        "type": "class",
        "id": "ElectricBike.RideActivity",
        "name": "RideActivity"
