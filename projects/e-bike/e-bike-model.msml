        "id": "ElectricBike.Behavior.Ride.ForkAssist",
        "type": "fork_node",
        "name": "Fork1"
      },
      {
        "id": "ElectricBike.Behavior.Ride.JoinAssist",
        "type": "join_node",
        "name": "Join1"
      },
      {
        "id": "ElectricBike.Behavior.Ride.RideFinal",
        "type": "activity_final_node",
        "name": "RideDone"
      },
      {
        "id": "ElectricBike.Behavior.Ride.ChargeFinal",
        "type": "activity_final_node",
