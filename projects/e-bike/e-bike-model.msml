      },
      {
        "id": "ElectricBike.State.RideControl.Start",
        "type": "initial_pseudostate",
        "name": "Init"
      },
      {
        "type": "state",
        "id": "ElectricBike.State.RideControl.off",
        "name": "off"
      },
      {
        "type": "state",
        "id": "ElectricBike.State.RideControl.standby",
        "name": "standby",
        "entry": "enableSensors()"
      },
      {
        "type": "state",
        "id": "ElectricBike.State.RideControl.assist",
        "name": "assist",
        "do": "modulateTorque()",
        "exit": "zeroAssist()"
      },
      {
        "type": "state",
        "id": "ElectricBike.State.RideControl.charging",
        "name": "charging",
        "do": "acceptCharge()"
      },
      {
        "type": "state",
        "id": "ElectricBike.State.RideControl.fault",
        "name": "fault",
        "entry": "inhibitMotor();\nopenContactor()"
      },
